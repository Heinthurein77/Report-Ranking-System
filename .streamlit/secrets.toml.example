# Copy this file to ".streamlit/secrets.toml" for local development.
# On Streamlit Community Cloud, paste this same structure into:
#   App settings -> Secrets
# NEVER commit the real secrets.toml file to git.

# Use the SECRET key (sb_secret_...), not the publishable/anon key -- this
# app authenticates its own users server-side and needs to bypass Row Level
# Security, which the publishable key does not.
[supabase]
SUPABASE_URL = "https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
SUPABASE_KEY = "sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx"
