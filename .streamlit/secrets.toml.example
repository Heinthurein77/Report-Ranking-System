# Copy this file to ".streamlit/secrets.toml" for local development.
# On Streamlit Community Cloud, paste this same structure into:
#   App settings -> Secrets
# NEVER commit the real secrets.toml file to git.
#
# This version uses real Supabase Auth + Row Level Security, so it needs
# BOTH keys, used for different purposes (see supabase_client.py):
#   - SUPABASE_ANON_KEY (sb_publishable_...): used for every normal
#     request, authenticated per-user via their login session, so RLS
#     policies actually apply.
#   - SUPABASE_SERVICE_KEY (sb_secret_...): used ONLY when an admin
#     provisions a new login (Supabase Auth's admin API requires it).
#     Never used for regular reads/writes.

SUPABASE_URL = "https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
SUPABASE_ANON_KEY = "sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_SERVICE_KEY = "sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx"
