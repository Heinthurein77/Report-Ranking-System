# Copy this file to ".streamlit/secrets.toml" for local development.
# On Streamlit Community Cloud, paste this same structure into:
#   App settings -> Secrets
# NEVER commit the real secrets.toml file to git.

GOOGLE_DRIVE_FOLDER_ID = "1AbCdEfGhIjKlMnOpQrStUvWxYz0123456"

[supabase]
url = "https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
key = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-supabase-key.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# GCP service account JSON, flattened into TOML. Generate this in
# Google Cloud Console -> IAM & Admin -> Service Accounts -> Keys -> Add Key (JSON),
# then share your Google Drive folder with the service account's client_email.
[gcp_service_account]
type = "service_account"
project_id = "your-gcp-project-id"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEA...\n-----END PRIVATE KEY-----\n"
client_email = "bu-ranking-uploader@your-gcp-project-id.iam.gserviceaccount.com"
client_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxx"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/bu-ranking-uploader%40your-gcp-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
